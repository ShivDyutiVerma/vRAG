# Copy to .env and fill in real values. .env is gitignored — never commit real keys.

# Sarvam AI — STT (Saaras, required per C1) + LLM (Sarvam-105B). Auth header: api-subscription-key.
# https://dashboard.sarvam.ai
SARVAM_API_KEY=

# Groq — candidate fast-inference LLM provider, probed alongside Sarvam in Phase 0.
# https://console.groq.com/keys
GROQ_API_KEY=

# Deployment (local default; Render/Docker set their own PORT at runtime)
PORT=8000

# Deploy-time only (not read by the app itself) — needed if you're the one redeploying via the
# Render API rather than clicking through the dashboard. See docs/DECISIONS_P.md P-005.
RENDER_API_KEY=
