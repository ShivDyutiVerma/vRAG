# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Sarvam AI — STT (required, C1) and optionally LLM/TTS
SARVAM_API_KEY=

# Generation provider fallback candidates (Phase 0 probe decides which is primary)
GROQ_API_KEY=

# Deployment (local default; Render/Docker set their own PORT at runtime)
PORT=8000

# Deploy-time only (not read by the app itself) — needed if you're the one redeploying via the
# Render API rather than clicking through the dashboard. See docs/DECISIONS_P.md P-005.
RENDER_API_KEY=
